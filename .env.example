# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Secret for user session tokens
JWT_SECRET="timebank_community_jwt_secret_key_2026_secure"

# SMTP Settings for email notifications (optional; logs graceful fallback when unconfigured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Time Bank Platform <notifications@timebank.community>"

# Payment Integration (PayHere sandbox / simulation)
PAYHERE_MERCHANT_ID="1225501"
PAYHERE_SECRET="sandbox_merchant_secret_key"
PAYHERE_MODE="sandbox"
